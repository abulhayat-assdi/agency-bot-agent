# Application
APP_ENV=development
APP_URL=http://localhost:3000
APP_NAME="AI Meta Ads Intelligence Platform"
# Set to true only for embedded HTTPS preview environments that require cross-site cookies.
PREVIEW_CROSS_SITE_COOKIES=false

# Authentication
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-initial-password
# Prefer ADMIN_BOOTSTRAP_PASSWORD_HASH in production. Generate with the auth hashing utility/test helper or a secure bcrypt tool.
ADMIN_BOOTSTRAP_PASSWORD_HASH=replace-with-bcrypt-password-hash

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meta_ads_intelligence

# Jobs
REDIS_URL=redis://localhost:6379
SYNC_INTERVAL_MINUTES=60

# Meta Marketing API - read-only Phase 1
META_GRAPH_API_VERSION=v26.0
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_SYSTEM_USER_ACCESS_TOKEN=replace-with-read-only-token
META_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=reports@example.com
